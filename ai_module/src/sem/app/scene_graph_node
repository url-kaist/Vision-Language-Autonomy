                except FileNotFoundError:
                    pass
                except Exception:
                    pass
                shm = shared_memory.SharedMemory(create=True, size=size, name=shm_graph_name)
                shm.buf[:size] = encoded
                shm.close()
                graph_shm_time = time.time() - t_graph_shm
                # self.logger.log(f"Saved graph to shared memory '{shm_graph_name}' ({size} bytes)")

            # Update last saved pose for offline_map throttling (디스크 저장한 경우만)
            if save_to_disk and current_pose is not None:
                self.last_offline_map_pose = current_pose

        if save_to_disk and obj_path is not None and graph_path is not None:
            # offline_t_total = time.time() - offline_t_start
            # disk_time = obj_disk_time + graph_disk_time
            # shm_time = obj_shm_time + graph_shm_time
            # self.logger.loginfo(
            #     "[offline_map/timing] "
