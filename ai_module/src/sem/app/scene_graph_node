    def pose_changed_enough(self, cur_pose, prev_pose, keyframe_dist=None, keyframe_deg=None):
        """
        Keyframe / offline_map pose change를
        "직전 저장 pose와의 거리/각도" 기준으로 판단한다.
        - 거리 기준: get_distance_between_poses(cur_pose, prev_pose)
          (임계값: offline_map_pose_threshold 기본 사용)
        - 각도 기준: get_angle_between_poses(cur_pose, prev_pose)
          (임계값: offline_map_angle_threshold 기본 사용)
        """
        if prev_pose is None:
            return True

        # 기본 threshold는 offline_map 설정과 동일하게 사용
        if keyframe_dist is None:
            keyframe_dist = getattr(self, "offline_map_pose_threshold", 0.1)
        if keyframe_deg is None:
            keyframe_deg = getattr(self, "offline_map_angle_threshold", 10.0)

        # 직전 pose와의 거리/각도
        dist = get_distance_between_poses(cur_pose, prev_pose)
        angle = get_angle_between_poses(cur_pose, prev_pose)

        self.logger.log(
            f"[KEYFRAME] Δpose: dist={dist:.2f} m (th={keyframe_dist} m), "
            f"angle={angle:.1f} deg (th={keyframe_deg} deg)"
        )
        return dist > keyframe_dist or angle > keyframe_deg

    def nearby_keyframes_exist(self, position, threshold=0.1):
        exist = False
        for kf in self.sg_graph.nodes:
            if kf.startswith("keyframe_"):
                kf_data = self.sg_graph.nodes[kf]
                kf_pos = kf_data["position"]
                dist = np.linalg.norm(np.array(kf_pos) - np.array(position))
                if dist < threshold:
                    exist = True
                    break
        return exist

