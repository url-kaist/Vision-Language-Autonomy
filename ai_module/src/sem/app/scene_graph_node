                        cv2.rectangle(debug_img, (x1, y1), (x2, y2), (0, 255, 0), 2)
                        txt = f"{label} {conf:.2f}"
                        cv2.putText(
                            debug_img,
                            txt,
                            (x1, max(0, y1 - 5)),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.5,
                            (0, 255, 0),
                            1,
                            cv2.LINE_AA,
                        )
                    height, width, _ = debug_img.shape
                    # 여기서는 YOLO 박스만 그리고, depth 기반 포인트 투영은
                    # 아래에서 obj_clouds_world 결과를 가지고 다시 그린다.

            sam_results = self.sam_model.predict(
                image.copy(), bboxes=bounding_boxes, verbose=False,
            )
            masks = sam_results[0].masks.data

            # SAM 마스크에 약간의 침식을 적용해서 경계를 더 보수적으로 만듦
            masks_np = []
            for i, box in enumerate(bounding_boxes):
                mask_i = masks[i].cpu().numpy().astype(np.uint8)
                # 박스 폭 기반으로 1D 커널 크기 결정
                try:
                    box_width = float(box[2] - box[0])
                except Exception:
                    box_width = mask_i.shape[1]
                kernel_width = int(box_width / 5.0)
                if kernel_width > 10:
                    kernel = np.ones((1, kernel_width), np.uint8)
                    eroded_mask = cv2.erode(mask_i, kernel, iterations=1)
                    masks_np.append(eroded_mask)
                else:
                    masks_np.append(mask_i)
            masks_np = np.array(masks_np)

            sam_boxes = []

            def mask_to_bbox(mask: torch.Tensor):
                if isinstance(mask, np.ndarray):
                    mask = torch.tensor(mask)
                coords = torch.nonzero(mask, as_tuple=True) # (y_indices, x_indices)
                if coords[0].numel() == 0 or coords[1].numel() == 0: # Check if there are any non-zero elements
                    return None
                y_indices, x_indices = coords

                x1, y1 = x_indices.min().item(), y_indices.min().item()
                x2, y2 = x_indices.max().item(), y_indices.max().item()
                return [x1, y1, x2, y2]

            for mask in masks:
                box = mask_to_bbox(mask)
                if box:
                    sam_boxes.append(box)

            t3 = time.time()
            projected_image = image.copy()

            # Kinect(depth) 기반 포인트 클라우드 사용 (가능하면)
            if self.use_depth_for_seg and (depth_image is not None):
                obj_clouds_world, pts_body_list, colors_list, semantic_labels = _generate_seg_comp_cloud_from_depth(
                    depth_image,
                    masks_np,
