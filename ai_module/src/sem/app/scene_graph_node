                    candidate2 = os.path.join(MODEL_WEIGHTS_DIR, sam_name)
                    if os.path.exists(candidate2):
                        sam_path = candidate2

            self.logger.loginfo(f"[SceneGraph] Load SAM model: {sam_path}")
            self.sam_model = SAM(sam_path).to(device)
        except Exception as e:
            self.logger.logerr(f"[SceneGraph] Failed to load SAM '{sam_name}': {e}. Fallback to mobile_sam.")
            try:
                fallback_path = os.path.join(MODEL_WEIGHTS_DIR, "ultralytics/mobile_sam.pt")
