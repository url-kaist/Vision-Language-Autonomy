        # 현재 시간보다 이 값 이상 오래되면 해당 프레임은 과감히 버리고 다음 프레임으로 넘어간다.
        self.max_image_lag_sec = float(config.get("max_image_lag_sec", 1.0))
        self.last_odom_pose = None
        # subscribe(이미지 입력)가 한 번이라도 돌았는지 여부
        self.has_image_input = False
        self._no_image_log_printed = False
        
        self.last_current_keyframe_time = 0 # JAY
        self.current_keyframe_time_interval = 1.0 # JAY
        self.max_keyframe_num = 5 # JAY

        # queues
        self.vision_queue = deque(maxlen=100000)
        self.odom_queue = deque(maxlen=100)

        ctx = mp.get_context('spawn')
        self.rgb_queue  = ctx.Queue()   # 콜백 → YOLO 프로세스
        self.yolo_queue = ctx.Queue()   # YOLO 프로세스 → 메인 스레드
        self.ctrl_queue = ctx.Queue()   # JAY

        self.sync_queue = {}
        self.lock       = threading.Lock()

        manager = ctx.Manager()
        self.shared_cfg = manager.dict({
            "classnames": self.classnames,
            "is_add": False,
            "confidence": self.confidence,
            "is_ready": False,
            # "input_downscale": self.yolo_downscale,
        })

        self.yolo_proc = ctx.Process(
            target=SceneGraphProcessor._yolo_process,
            args=(self.yolo_model, self.rgb_queue, self.yolo_queue, self.test_pipeline, self.shared_cfg, self.ctrl_queue,
                  self.perception_debug_dir, self.logger),
            daemon=True
        )
        self.yolo_proc.start()

        self.fields = [
            PointField(name="x", offset=0, datatype=PointField.FLOAT32, count=1),
            PointField(name="y", offset=4, datatype=PointField.FLOAT32, count=1),
            PointField(name="z", offset=8, datatype=PointField.FLOAT32, count=1),
            PointField(name="rgb", offset=12, datatype=PointField.UINT32, count=1),
        ]

        # self.default_classnames = ['table','person','traffic_cone','cardboard_box','backpack','laptop','trash_bin','bicycle','umbrella','wooden_table','floor_lamp','stop_sign','handbag','stroller','security_camera','wall_clock','light_switch','power_outlet','thermostat','smoke_detector','sprinkler_head']
        classnames = config['classnames']
        self.logger.loginfo(f"classnames: {classnames}")
        if len(classnames) == 0:
            self.already_set_classes = False
        else:
            self.already_set_classes = True
            classnames = ["{}".format(name.replace("_", " ")) for name in classnames]
            self.classnames = list(set(classnames))
            # self.yolo_model.set_classes(self.classnames) # It is not working

            self.obj_classes = self.classnames
            self.color_map = {
                idx: tuple(random.randint(0, 255) for _ in range(3))
                for idx in range(len(self.classnames))
            }

            self.ctrl_queue.put(("set_classes", self.classnames))
        self.untracked_id = -1
        # ROS I/O (Test)
        # self.rgb_sub = rospy.Subscriber("/camera/image", CompressedImage, self.test_callback, callback_args="image", queue_size=1)
        # self.cloud_sub = rospy.Subscriber("/sensor_scan", PointCloud2, self.test_callback, callback_args="cloud", queue_size=1)
        # self.odom_sub = rospy.Subscriber("/state_estimation", Odometry, self.test_callback, callback_args="odom", queue_size=10)
        # self.traversable_area_sub = rospy.Subscriber("/traversable_area_filtered", PointCloud2, self.test_callback, callback_args="traversable", queue_size=10) # Test

        # 설정
        # - real_world: launch 파일(real_world arg → /real_world param)에서만 제어
        cfg_real_world = bool(config.get("real_world", True))
        self.is_real_world = rospy.get_param("/real_world", cfg_real_world)

        # - use_depth_for_seg / compressed_image: config.json / real_robot.json 에서만 제어
        self.use_depth_for_seg = bool(config.get("use_depth_for_seg", True))
        self.is_compressed_image = bool(config.get("compressed_image", False))

        self.logger.logwarn(
            f"real_world={self.is_real_world}, use_depth_for_seg={self.use_depth_for_seg}, compressed_image={self.is_compressed_image}"
        )
        if self.is_real_world and self.use_depth_for_seg and self.is_compressed_image:
            self.logger.logwarn("YEEEEEEEEEEAHHHHHHHHHHHHHHHHHHHH")

        self.image_topic = config.get("image_topic", "/camera/image")
        self.depth_topic = config.get("depth_topic", "/camera/depth_image")
        self.lidar_topic = config.get("lidar_topic", "/registered_scan")
        self.odom_topic = config.get("odom_topic", "/state_estimation")

        # 압축 사용 시, topic suffix를 transport 규칙에 맞게 추가
        if self.is_compressed_image:
            if not self.image_topic.endswith("/compressed"):
                self.image_topic += "/compressed"
            if not self.depth_topic.endswith("/compressedDepth"):
                self.depth_topic += "/compressedDepth"

        self.logger.logwarn(
            f"subscribed topics: rgb: {self.image_topic}, depth: {self.depth_topic}, lidar: {self.lidar_topic}, odom: {self.odom_topic}"
        )

        # RGB subscriber (real/sim 공통, config 기반)
        if self.is_compressed_image:
            self.rgb_sub = Subscriber(self.image_topic, CompressedImage)
        else:
            self.rgb_sub = Subscriber(self.image_topic, Image)
        self.logger.loginfo(f"Subscribe RGB: {self.image_topic}")

        # Depth subscriber (real/sim 공통, config 기반)
        if self.use_depth_for_seg:
            if self.is_compressed_image:
                self.depth_sub = Subscriber(self.depth_topic, CompressedImage)
            else:
                self.depth_sub = Subscriber(self.depth_topic, Image)
        else:
            self.depth_sub = None

        # LiDAR / odom topic (config 기반)
        self.cloud_sub = Subscriber(self.lidar_topic, PointCloud2)
        self.odom_sub = rospy.Subscriber(self.odom_topic, Odometry, self.odom_callback, queue_size=2)

        # Debug image publisher (real world only)
        if self.is_real_world:
            self.yolo_debug_img_pub = rospy.Publisher("/debug/yolo_image", Image, queue_size=1)
            # 디버그 이미지 publish 주기 (Hz). 0.2초마다 = 5 Hz
            self.debug_publish_rate = 5.0  # Hz
            self.last_debug_pub_time = rospy.Time(0)
        else:
            self.yolo_debug_img_pub = None
        if self.use_depth_for_seg:
            if self.is_real_world:
                print("ApproximateTimeSynchronizer with depth (no lidar)")
                self.sync_sub = ApproximateTimeSynchronizer(
                    [self.rgb_sub, self.depth_sub], queue_size=1, slop=0.01
                )
            else:
                print("ApproximateTimeSynchronizer with depth + lidar")
                self.sync_sub = ApproximateTimeSynchronizer(
                    [self.rgb_sub, self.depth_sub, self.cloud_sub], queue_size=20, slop=0.1
                )
        else:
            print("ApproximateTimeSynchronizer lidar only")
            self.sync_sub = ApproximateTimeSynchronizer(
                [self.rgb_sub, self.cloud_sub], queue_size=10, slop=0.05
            )
        self.sync_sub.registerCallback(self.sync_callback)


        self.frame_id = "world" if self.is_real_world else "map"
        # DBSCAN 파라미터
        if self.use_depth_for_seg:
            self.dbscan_eps = 0.03
        elif self.is_real_world:
            self.dbscan_eps = 0.5
        else:
            self.dbscan_eps = 0.2

        # keyframe / pose 변화 임계값 (config에서 설정 가능)
        if self.is_real_world:
            self.keyframe_dist = float(config.get("keyframe_dist_real", 0.5))
            self.keyframe_angle_deg = float(config.get("keyframe_angle_deg_real", 10.0))
        else:
            self.keyframe_dist = float(config.get("keyframe_dist_sim", 3.0))
            self.keyframe_angle_deg = float(config.get("keyframe_angle_deg_sim", 10.0))

        self.hash_map_pub = rospy.Publisher(
            "/hash_map", PointCloud2, queue_size=1
        )
        self.graph_markers_pub = rospy.Publisher(
            "/scene_graph_markers", MarkerArray, queue_size=1
        )
        self.object_markers_pub = rospy.Publisher(
            "/object_marker", MarkerArray, queue_size=1
        )
        self.fov_marker_pub = rospy.Publisher("/fov_marker", Marker, queue_size=10)

        self.object_markers = None
        self.graph_markers = None
        self.save_srv = rospy.Service('/save_data', Empty, self.handle_save_data)
        self.logger.log(f"SceneGraphProcessor initialized (quiet={quiet}) — Send task when ready.")

        self.add_classes_srv = rospy.Service('/scene_graph/add_classes', SetClasses, self.handle_add_classes) # DSHONG
        self.set_classes_srv = rospy.Service('/scene_graph/set_classes', SetClasses, self.handle_set_classes)  # DSHONG
        self.active_signal_srv = rospy.Service('/scene_graph/active_signal', Trigger, self.handle_active_signal)  # DSHONG

        self.publish_thread = threading.Thread(target=self.publish_loop, daemon=True)
        self.main_thread    = threading.Thread(target=self.run, daemon=True)
        self.sync_thread = threading.Thread(target=self.sync_loop, daemon=True)
        for t in (self.sync_thread, self.main_thread, self.publish_thread):
