    def handle_save_data(self, req):

        def convert_numpy_types(obj):
            if isinstance(obj, np.ndarray):
                return obj.tolist()  # Convert numpy arrays to lists
            elif isinstance(obj, np.float32):
                return float(obj)  # Convert numpy float32 to native Python float
            elif isinstance(obj, np.int32):
                return int(obj)  # Convert numpy int32 to native Python int
            elif isinstance(obj, dict):
                return {key: convert_numpy_types(value) for key, value in obj.items()}
            elif isinstance(obj, list):
                return [convert_numpy_types(item) for item in obj]
            else:
                return obj

        # Pose-based throttling:
        # - offline_map 디스크(objects.json, scene_graph.json)와 SHM(object_shm, scene_graph_shm)을
        #   항상 동일한 시점/내용으로 저장한다.
        # - dist/angle threshold를 만족하지 않으면 둘 다 갱신하지 않는다.
        current_pose = None
        save_to_disk = True
        # offline_map / SHM 저장 시간 측정을 위한 변수
        offline_t_start = time.time()
        obj_disk_time = 0.0
        obj_shm_time = 0.0
        graph_disk_time = 0.0
        graph_shm_time = 0.0
        with self.lock:
            if hasattr(self, "current_pose"):
                current_pose = self.current_pose
            if current_pose is None:
                save_to_disk = False
                self.logger.logwarn("[offline_map] Skip save: no odometry available")
                return EmptyResponse()

            # 직전 offline_map pose와의 거리/각도 기준으로 저장 여부 결정
            if self.last_offline_map_pose is not None:
                # pose_changed_enough를 offline map 용으로 재사용
                dist = get_distance_between_poses(current_pose, self.last_offline_map_pose)
                angle = get_angle_between_poses(current_pose, self.last_offline_map_pose)
                enough = self.pose_changed_enough(
                    current_pose,
                    self.last_offline_map_pose,
                    keyframe_dist=self.offline_map_pose_threshold,
                    keyframe_deg=self.offline_map_angle_threshold,
                )
                if not enough:
                    self.logger.logwarn(
                        f"[offline_map] Skip disk save: dist {dist:.2f} m (th={self.offline_map_pose_threshold:.2f} m), "
                        f"rot {angle:.1f} deg (th={self.offline_map_angle_threshold:.1f} deg)"
                    )
                    return EmptyResponse()
            else:
                # 첫 저장: 이전 pose가 없으므로 dist/angle=0으로 로그만 참고
                dist = 0.0
                angle = 0.0

        self.logger.logwarn(
            f"[offline_map] Disk save: dist {dist:.2f} m (th={self.offline_map_pose_threshold:.2f} m), "
            f"rot {angle:.1f} deg (th={self.offline_map_angle_threshold:.1f} deg)"
        )
        
        base_dir = os.environ.get("OFFLINE_MAP_DIR", "/ws/external/offline_map")
        self.logger.loginfo(f"base_dir: {base_dir}")
        save_dir = None
        if save_to_disk:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            save_dir = os.path.join(base_dir, timestamp)
            os.makedirs(save_dir, exist_ok=True)
        with self.lock:
            obj_path = None
            graph_path = None
            if save_dir is not None:
                # pcd_path = os.path.join(save_dir, 'hash_pointcloud.pcd')
                obj_path = os.path.join(save_dir, 'objects.json')
                graph_path = os.path.join(save_dir, 'scene_graph.json')

            # Save point cloud data
            # pts_list = []
            # for pts in self.map_hash.values():
            #     for pt in pts:
            #         pts_list.append(pt[:3])
            # pcd = o3d.geometry.PointCloud()
            # pcd.points = o3d.utility.Vector3dVector(np.array(pts_list, dtype=np.float32))
            # o3d.io.write_point_cloud(pcd_path, pcd)

            # Prepare objects data
            serializable_objects = {}
            hash_keys_per_id = {}
            for key, pts in self.map_hash.items():
                for pt in pts:
                    oid = int(pt[3])
                    hash_keys_per_id.setdefault(oid, []).append(int(key))

            for oid, info in self.objects.items():
                try:
                    serializable_objects[int(oid)] = {
                        'instance_id':  int(info['id']),
                        'class_ids':    info['class_ids'], # TODO: int?
                        'class_name':   info['class_name'],
                        'n_points':     info['n_points'],
                        'center':       info['center'].tolist(),
                        'min_bbox':     info['min_bbox'].tolist(),
                        'max_bbox':     info['max_bbox'].tolist(),
                        # 'point_hash_key': hash_keys_per_id.get(int(oid), []),
                        'points': info['points'],
                    }
                except Exception as e: # TODO: handle specific exception
                    self.logger.log(f"Error processing object {oid}: {e}")
                    continue

            for oid, info in self.missing_objects.items():
                if int(oid) in serializable_objects and info['class_id'] in serializable_objects[oid]["class_ids"]:
                    self.logger.log("self.missing_objects {oid} already existing")
                    continue

                #####REVISED
                serializable_objects[int(oid)] = {
                    'instance_id':  int(info['id']),
                    "class_id":     info["class_id"],
                    'class_name':   info['class_name'],
                    'points':       info['points'],
                    # 'bbox_by_kf':   info['bbox_by_kf'],
                }
            # Convert numpy types and save the objects JSON / SHM
            json_objects = convert_numpy_types(serializable_objects)
            if len(json_objects) == 0:
                self.logger.logwarn("[offline_map] No objects to serialize; objects.json will be empty")

            if save_to_disk and obj_path is not None:
                # 디스크 objects.json과 SHM(object_shm)을 동일한 시점/내용으로 저장
                t_obj_disk = time.time()
                with open(obj_path, 'w') as f:
                    json.dump(json_objects, f, indent=2)
                obj_disk_time = time.time() - t_obj_disk

                shm_obj_name = "object_shm"
                json_str = json.dumps(json_objects)
                encoded = json_str.encode("utf-8")
                size = len(encoded)
                t_obj_shm = time.time()
                try:
                    existing_shm = shared_memory.SharedMemory(name=shm_obj_name)
                    existing_shm.close()
                    existing_shm.unlink()
                except FileNotFoundError:
                    pass
                except Exception:
                    pass
                shm = shared_memory.SharedMemory(create=True, size=size, name=shm_obj_name)
                shm.buf[:size] = encoded
                shm.close()
                obj_shm_time = time.time() - t_obj_shm
                # self.logger.log(f"Saved objects to shared memory '{shm_obj_name}' ({size} bytes)")
                if size <= 5:
                    self.logger.logwarn(
                        f"[offline_map] object_shm size is very small ({size} bytes); "
                        f"check if serialized objects are correct."
                    )
            ########

            # Prepare graph data
            place_nodes_by_id = {}
            node_attrs = {}
            for node_id, attr in self.sg_graph.nodes(data=True):
                pos = attr.get("position")
                if hasattr(pos, "tolist"):
                    attr["position"] = pos.tolist()
                node_attrs[node_id] = attr
                if attr.get("type") == "place":
                    pid = attr.get("instance_id", attr.get("id"))
                    if pid is None:
                        try:
                            pid = int(str(node_id).split("_")[-1])
                        except Exception:
                            pid = None
                    if pid is not None:
                        place_nodes_by_id[int(pid)] = attr

            serialized_nodes = []
            node_references = {}
            for node_id, attr in node_attrs.items():
                node_type = attr.get("type")
                if node_type == "place":
                    pid = attr.get("instance_id", attr.get("id"))
                    if pid is None:
                        try:
                            pid = int(str(node_id).split("_")[-1])
                        except Exception:
                            pid = None
                    if pid is not None:
                        node_references[node_id] = {"level": "NodeLevel.PLACE", "id": int(pid)}
                    continue
                if node_type not in ("object", "keyframe"):
                    continue

                node_entry = dict(attr)
                serialized_id = attr.get("instance_id") if node_type == "object" else attr.get("id")
                if serialized_id is None:
                    try:
                        serialized_id = int(str(node_id).split("_")[-1])
                    except Exception:
                        serialized_id = None
                else:
                    try:
                        serialized_id = int(serialized_id)
                    except Exception:
                        pass

                if node_type == "object":
                    node_entry["level"] = "NodeLevel.OBJECT"
                    node_entry["id"] = serialized_id
                    if "name" not in node_entry and "class_name" in node_entry:
                        node_entry["name"] = node_entry["class_name"]

                    instance_id = node_entry.get("instance_id")
                    pts = None
                    if instance_id is not None and instance_id in self.objects:
                        obj_info = self.objects[instance_id]
                        pts = obj_info.get("points", None)
                        # points가 없거나 비어 있는 object는 scene_graph.json에 기록하지 않음
                        if pts is None or (
                            isinstance(pts, np.ndarray) and pts.size == 0
                        ) or (not isinstance(pts, np.ndarray) and hasattr(pts, "__len__") and len(pts) == 0):
                            continue
                        if isinstance(pts, np.ndarray):
                            pts = pts.tolist()
                        if "points" not in node_entry:
                            node_entry["points"] = pts

                        min_bbox = obj_info.get("min_bbox", None)
                        max_bbox = obj_info.get("max_bbox", None)
                        if min_bbox is not None and max_bbox is not None:
                            min_arr = np.asarray(min_bbox, dtype=float)
                            max_arr = np.asarray(max_bbox, dtype=float)
                            centroid = (min_arr + max_arr) / 2.0
                            extent = max_arr - min_arr
                        elif pts is not None:
                            pts_np = np.asarray(pts, dtype=float)
                            centroid = pts_np.mean(axis=0)
                            extent = pts_np.max(axis=0) - pts_np.min(axis=0)
                        else:
                            centroid = np.zeros(3, dtype=float)
                            extent = np.zeros(3, dtype=float)

                        node_entry["centroid"] = np.asarray(centroid, dtype=float).tolist()
                        node_entry["extent"] = np.asarray(extent, dtype=float).tolist()
                        node_entry["R"] = np.eye(3, dtype=float).tolist()
                    else:
                        pts = node_entry.get("points", None)
                        if pts is not None:
                            pts_np = np.asarray(pts, dtype=float)
                            if pts_np.size > 0:
                                centroid = pts_np.mean(axis=0)
                                extent = pts_np.max(axis=0) - pts_np.min(axis=0)
                                node_entry["centroid"] = np.asarray(centroid, dtype=float).tolist()
                                node_entry["extent"] = np.asarray(extent, dtype=float).tolist()
                                node_entry["R"] = np.eye(3, dtype=float).tolist()

                    if node_entry.get("instance_id") is not None:
                        try:
                            node_entry["id"] = int(node_entry["instance_id"])
                        except Exception:
                            node_entry["id"] = node_entry["instance_id"]

                elif node_type == "keyframe":
                    node_entry["level"] = "NodeLevel.KEYFRAME"
                    node_entry["id"] = serialized_id
                    place_info = place_nodes_by_id.get(serialized_id, {})
                    if "image_path" not in node_entry:
                        node_entry["image_path"] = place_info.get("image_path")
                    if "pose" not in node_entry:
                        node_entry["pose"] = place_info.get("pose")
                    if "detections" not in node_entry:
                        dets = []
                        for det in place_info.get("detections", []) or []:
                            bbox = det.get("bbox", [])
                            if hasattr(bbox, "tolist"):
                                bbox = bbox.tolist()
                            score = det.get("yolo_conf", det.get("score", 0.0))
                            try:
                                score = float(score)
                            except Exception:
                                pass
                            det_id = det.get("id", -1)
                            try:
                                det_id = int(det_id)
                            except Exception:
                                pass
                            dets.append({
                                "id": det_id,
                                "bbox": bbox,
                                "score": score,
                                "name": det.get("class_name", det.get("name", "")),
                            })
                        node_entry["detections"] = dets

                if isinstance(node_entry["id"], str):
                    try:
                        node_entry["id"] = int(node_entry["id"])
                    except Exception:
                        pass

                serialized_nodes.append(node_entry)
                node_references[node_id] = {
                    "level": node_entry.get("level"),
                    "id": node_entry["id"],
                }

            serialized_edges = []
            for source_key, target_key, attr in self.sg_graph.edges(data=True):
                if source_key not in node_references or target_key not in node_references:
                    continue
                edge_entry = {
                    "source": node_references[source_key],
                    "target": node_references[target_key],
                    "direction": attr.get("direction", "BIDIRECTIONAL"),
                }
                for k, v in attr.items():
                    if k not in edge_entry:
                        edge_entry[k] = v
                serialized_edges.append(edge_entry)

            # self.logger.loginfo(f"serialized_nodes: {len(serialized_nodes)}")
            # self.logger.loginfo(f"serialized_edges: {len(serialized_edges)}")
            graph_data = {
                "nodes": serialized_nodes,
                "edges": serialized_edges,
            }

            # Convert numpy types and save the graph JSON / SHM
            json_graph = convert_numpy_types(graph_data)

            if save_to_disk and graph_path is not None:
                # 디스크 scene_graph.json과 SHM(scene_graph_shm)을 동일한 시점/내용으로 저장
                t_graph_disk = time.time()
                with open(graph_path, 'w') as f:
                    json.dump(json_graph, f, indent=2)
                graph_disk_time = time.time() - t_graph_disk

                shm_graph_name = "scene_graph_shm"
                json_str = json.dumps(json_graph)
