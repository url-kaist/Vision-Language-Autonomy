            cur_pose = np.eye(4)
            cur_pose[:3, :3] = pose["rotation"]
            cur_pose[:3, 3] = pose["position"]

            # obtain YOLO and SAM results
            if (
                boxes is None
                or boxes.tracker_id is None
                or boxes.xyxy is None
