                        cloud_body,
                        masks_np,
                        labels,  # same order with masks_np
                        pose["rotation"],
                        pose["position"],
                        image_src=image.copy(),
                        platform="wheelchair",
                        label_ids=self.classnames
                        # index=iter
                    )

            # Depth 기반 포인트클라우드(obj_clouds_world)를
            # RGB 이미지에 다시 투영해서 시각화 (디버그용)
            if (
                self.is_real_world
                and self.use_depth_for_seg
                and (depth_image is not None)
                and (self.yolo_debug_img_pub is not None)
                and obj_clouds_world
            ):
                vis_now = rospy.Time.now()
                if (vis_now - self.last_debug_pub_time).to_sec() > 1.0 / self.debug_publish_rate:
                    debug_img = image.copy()
                    # 1) YOLO 박스/레이블 다시 그리기
                    for i, box in enumerate(bounding_boxes):
                        x1, y1, x2, y2 = map(int, box)
                        cls_id = class_ids[i]
                        conf = confs[i]
                        label = self.obj_classes[cls_id] if 0 <= cls_id < len(self.obj_classes) else str(cls_id)
                        cv2.rectangle(debug_img, (x1, y1), (x2, y2), (0, 255, 0), 2)
                        txt = f"{label} {conf:.2f}"
                        cv2.putText(
                            debug_img,
                            txt,
                            (x1, max(0, y1 - 5)),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.5,
                            (0, 255, 0),
                            1,
                            cv2.LINE_AA,
                        )

                    height, width, _ = debug_img.shape

                    # 2) pts_body_list (body 좌표)를 RGB 이미지로 투영
                    H_rgb, W_rgb, _ = image.shape

                    # RGB 카메라 intrinsic (480x640 기준, CameraInfo)
                    if H_rgb == 480 and W_rgb == 640:
                        fx_rgb = 606.040283203125
                        fy_rgb = 606.2955932617188
                        cx_rgb = 328.3797912597656
                        cy_rgb = 245.35792541503906
                    else:
                        # 해상도가 다른 경우에는 대략적인 intrinsic 사용
                        fx_rgb = W_rgb / 2.0
                        fy_rgb = H_rgb / 2.0
                        cx_rgb = W_rgb / 2.0
                        cy_rgb = H_rgb / 2.0

                    max_range = 5.0  # [m], 이 이상은 far

                    for pts_body in pts_body_list:
                        if pts_body is None:
                            continue
                        pts_body = np.asarray(pts_body, dtype=np.float32)
                        if pts_body.size == 0:
                            continue

                        # body → camera 좌표 변환 (camera 기준으로 투영)
                        # pts_body = pts_cam @ R_cb^T  =>  pts_cam = pts_body @ R_cb
                        pts_cam = pts_body @ self.cam_to_body_R

                        Z = pts_cam[:, 2]
                        valid = (Z > 0) & np.isfinite(Z)
                        if not np.any(valid):
                            continue
                        pts_cam = pts_cam[valid]
                        Z = Z[valid]
                        X = pts_cam[:, 0]
                        Y = pts_cam[:, 1]

                        u = fx_rgb * (X / Z) + cx_rgb
                        v = fy_rgb * (Y / Z) + cy_rgb

                        u = u.astype(np.int32)
                        v = v.astype(np.int32)

                        in_img = (u >= 0) & (u < width) & (v >= 0) & (v < height)
                        if not np.any(in_img):
                            continue

                        u = u[in_img]
                        v = v[in_img]
                        Z_draw = Z[in_img]

                        # 너무 많으면 샘플링
                        step_pts = max(1, int(len(u) / 2000))

                        for uu, vv, d in zip(u[::step_pts], v[::step_pts], Z_draw[::step_pts]):
                            # 깊이에 따라 색상 변경 (가까울수록 노랑, 멀수록 밝은 빨강)
                            val = float(np.clip(d / max_range, 0.0, 1.0))
                            # BGR: near -> (0,255,255) (yellow), far -> (0,0,255) (red)
                            b = 0
                            r = 255
                            g = int(255 * (1.0 - val))
                            cv2.circle(
                                debug_img,
                                (int(uu), int(vv)),
                                2,
                                (b, g, r),
                                -1,
                                lineType=cv2.LINE_AA,
                            )

                    # 디버그용 depth 세그 포인트 투영 이미지 저장 및 publish
