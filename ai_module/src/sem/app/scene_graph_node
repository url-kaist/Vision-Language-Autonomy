def cleanup_shared_memory():
    for shm_name in ("object_shm", "scene_graph_shm"):
        try:
            shm = shared_memory.SharedMemory(name=shm_name)
            shm.close()
            shm.unlink()
            print(f"[cleanup_shared_memory] Deleted shared memory '{shm_name}'")
        except FileNotFoundError:
            print(f"[cleanup_shared_memory] No such file named '{shm_name}'")
            pass
        except Exception:
            pass

class LabelAnnotator(sv.LabelAnnotator):

    @staticmethod
    def resolve_text_background_xyxy(
        center_coordinates,
        text_wh,
        position,
    ):
        center_x, center_y = center_coordinates
        text_w, text_h = text_wh
        return center_x, center_y, center_x + text_w, center_y + text_h


class SceneGraphProcessor:
    def __init__(self):
        quiet = rospy.get_param('~quiet', False)
        self.logger = Logger(
            quiet=quiet, prefix='SceneGraph', log_path="/ws/external/log/scene_graph.log")
        base_dir = os.environ.get("OFFLINE_MAP_DIR", "/ws/external/offline_map")
        if os.path.exists(base_dir) and os.path.isdir(base_dir):
            shutil.rmtree(base_dir)
        os.makedirs(base_dir, exist_ok=True)

        self.debug = rospy.get_param('~debug', False)
        # Load Configuration
        config_path = rospy.get_param('~config', "/ws/external/ai_module/src/sem/config/simulation.json")
        with open(config_path, "r") as f:
            config = json.load(f)
        self.logger.loginfo(f"=== configuration ===")
        for k, v in config.items():
            self.logger.loginfo(f"  {k} : {v}")
        self.logger.loginfo(f"=====================")

        # robot height (body frame z 기준) 설정
        # - body z ≈ -robot_height 근처 포인트는 로봇 바로 아래/바닥으로 간주해서 제거
        self.robot_height = float(config.get("robot_height", 0.3))
        self.robot_height_margin = float(config.get("robot_height_margin", 0.05))

        # RGB / Depth intrinsic (config에서 선택적으로 로드)
        self.depth_K = None
        self.rgb_K = None
        try:
            depth_intr = config.get("depth_intrinsics")
            if depth_intr is not None:
                if isinstance(depth_intr, dict):
                    fx = float(depth_intr.get("fx"))
                    fy = float(depth_intr.get("fy"))
                    cx = float(depth_intr.get("cx"))
                    cy = float(depth_intr.get("cy"))
                    self.depth_K = np.array(
                        [[fx, 0.0, cx], [0.0, fy, cy], [0.0, 0.0, 1.0]],
                        dtype=np.float32,
                    )
                else:
                    depth_arr = np.asarray(depth_intr, dtype=np.float32)
                    if depth_arr.shape == (3, 3):
                        self.depth_K = depth_arr

            rgb_intr = config.get("rgb_intrinsics")
            if rgb_intr is not None:
                if isinstance(rgb_intr, dict):
                    fx = float(rgb_intr.get("fx"))
                    fy = float(rgb_intr.get("fy"))
                    cx = float(rgb_intr.get("cx"))
                    cy = float(rgb_intr.get("cy"))
                    self.rgb_K = np.array(
                        [[fx, 0.0, cx], [0.0, fy, cy], [0.0, 0.0, 1.0]],
                        dtype=np.float32,
                    )
                else:
                    rgb_arr = np.asarray(rgb_intr, dtype=np.float32)
                    if rgb_arr.shape == (3, 3):
                        self.rgb_K = rgb_arr
        except Exception as e:
            self.logger.logwarn(f"[SceneGraph] Failed to parse camera intrinsics from config: {e}")

        perception_debug_dir = "/ws/external/perception_debug"
        for file_path in glob.glob(os.path.join(perception_debug_dir, "*")):
            if os.path.isfile(file_path):
                os.remove(file_path)
            if os.path.isdir(file_path):  # JAY
                shutil.rmtree(file_path)
        os.makedirs(perception_debug_dir, exist_ok=True)
        self.perception_debug_dir = perception_debug_dir

        image_save_dir = os.environ.get("KEYFRAMES_DIR", "/ws/external/keyframes")
        for file_path in glob.glob(os.path.join(image_save_dir, "*")):
            if os.path.isfile(file_path):
                os.remove(file_path)
            if os.path.isdir(file_path): # JAY
                shutil.rmtree(file_path)
        os.makedirs(image_save_dir, exist_ok=True)
        self.image_path = image_save_dir + "/{}.jpg"

        self.bridge = CvBridge()
        self.lock = threading.Lock()
        self.running = True
        self.map_inner_margin = 0.2 # (m)

        # SAM 실행 주기 (트래킹된 object에 대해 N 프레임마다 수행)
        self.sam_interval = int(config.get("sam_interval", 1))

        # data
        self.obj_classes = MATTERPORT_LABELS_160
        self.color_map = {i + 1: color for i, color in enumerate(MATTERPORT_COLOR_MAP_160.values())}
        
        
        # perception
        # Optional config: /ws/external/ai_module/src/config.json
        # If keys are missing, fall back to defaults without raising KeyError.
        self.model_size = "x"  # default: m / l / x
        self.confidence = 0.4  # default YOLO confidence
        self.sam_model_name = "mobile_sam.pt" #"sam_b.pt"
        # YOLO 입력 해상도 다운스케일 비율 (1.0 = 원본)
        self.yolo_downscale = 1.0
        try:
            with open("/ws/external/ai_module/src/config.json", "r") as f:
                yolo_config = json.load(f)
            self.model_size = yolo_config.get("YOLO_MODEL_SIZE", self.model_size)
            self.confidence = yolo_config.get("YOLO_CONFIDENCE", self.confidence)
            self.sam_model_name = yolo_config.get("SAM_MODEL_NAME", self.sam_model_name)
            self.yolo_downscale = float(yolo_config.get("YOLO_DOWNSCALE", self.yolo_downscale))
        except Exception as e:
            self.logger.logwarn(
                f"[SceneGraph] config.json not found or invalid, "
                f"use defaults (size={self.model_size}, conf={self.confidence}, sam={self.sam_model_name}). "
