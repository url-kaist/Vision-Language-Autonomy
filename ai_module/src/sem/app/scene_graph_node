    def get_latest_blocking(self, q):
        """YOLO 결과 큐에서 '가장 최신' 항목 하나를 blocking으로 가져온다."""
        try:
            # 최초 결과를 timeout을 두고 대기
            item = q.get(timeout=0.3)
        except pyqueue.Empty:
            self.logger.logwarn("yolo get timeout (no result within 0.3s)")
            return None
        # 큐에 backlog가 있으면 모두 비우고 마지막 것만 사용
        while True:
            try:
                item = q.get_nowait()
            except pyqueue.Empty:
                break

        return item

