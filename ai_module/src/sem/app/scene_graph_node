        self.keyframe_counter = 0
        self.place_positions = {}
        self.last_keyframe_id = 0
        self.last_keyframe_pose = None

        # offline_map / keyframe pose 변화 임계값
        self.offline_map_pose_threshold = float(config.get("offline_map_pose_threshold", 0.3))   # [m]
        self.offline_map_angle_threshold = float(config.get("offline_map_angle_threshold", 20.0)) # [deg]
        self.last_offline_map_pose = None
        # odom 기반으로 이미지 큐 리셋을 판단할 때 기준이 되는 pose
        self.last_image_reset_pose = None
        # odom 기반 누적 주행거리 계산 시, 노이즈로 인한 아주 작은 변위는 무시하기 위한 최소 step 거리
