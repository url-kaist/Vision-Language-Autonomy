    def odom_callback(self, odom_msg):
        stamp = odom_msg.header.stamp.to_nsec()
        pose = self.odom_msg_to_pose(odom_msg)

        reset_queues = False

        with self.lock:
            self.odom_queue.append((stamp, pose))
            self.current_pose = pose
            # 누적 주행거리 업데이트 (odom 연속 프레임 간 변위의 합)
            # - odom 노이즈 때문에 정지 상태에서도 미세한 위치 변화가 계속 들어올 수 있으므로
            #   너무 작은 변위(< odom_min_step_dist)는 무시한다.
            if self.last_odom_pose is None:
                self.last_odom_pose = pose
            else:
                prev_p = self.last_odom_pose[:3, 3]
                cur_p = pose[:3, 3]
                d = float(np.linalg.norm(cur_p - prev_p))
                if d >= self.odom_min_step_dist:
                    # "유의미한" 이동이 있을 때만 기준 pose를 업데이트
                    self.last_odom_pose = pose

            # pose 변화가 충분히 크면 이미지/YOLO 관련 큐를 리셋
            if self.last_image_reset_pose is None:
                self.last_image_reset_pose = pose
            else:
                dist = get_distance_between_poses(pose, self.last_image_reset_pose)
                angle = get_angle_between_poses(pose, self.last_image_reset_pose)
                if dist > 0.05 or angle > 1.0:
                    reset_queues = True
                    self.last_image_reset_pose = pose
                    if len(self.vision_queue) > 0:
                        last_item = self.vision_queue[-1]
                        self.vision_queue.clear()
                        self.vision_queue.append(last_item)
                    if len(self.sync_queue) > 0:
                        latest_stamp = max(self.sync_queue.keys())
                        latest_entry = self.sync_queue[latest_stamp]
                        self.sync_queue.clear()
                        self.sync_queue[latest_stamp] = latest_entry

        if reset_queues:
            # RGB / YOLO multiprocessing 큐에 쌓인 이전 프레임도 제거
            try:
                while True:
                    self.rgb_queue.get_nowait()
            except queue.Empty:
                pass
            try:
                while True:
                    self.yolo_queue.get_nowait()
            except queue.Empty:
                pass
            self.logger.loginfo("[odom] Pose changed enough; cleared image/YOLO queues")

    def sync_callback(self, img_msg, *args):
        if not self.already_set_classes:
            return
        # self.logger.loginfo(f"sync_callback")
        stamp = img_msg.header.stamp.to_nsec()
        try:
            if self.is_compressed_image:
                # CompressedImage → BGR8
                rgb = self.bridge.compressed_imgmsg_to_cv2(
                    img_msg, desired_encoding="bgr8"
                )
            else:
                rgb = self.bridge.imgmsg_to_cv2(
                    img_msg, desired_encoding="bgr8"
                )
        except Exception as e:
            self.logger.logerr(f"[sync_callback] Failed to decode RGB image: {e}")
            return

        # 압축 해제 후 RGB 해상도 로그 (한 번만)
        if not hasattr(self, "_logged_rgb_shape"):
            self._logged_rgb_shape = True
            h_rgb, w_rgb = rgb.shape[:2]
            self.logger.loginfo(
                f"[sync_callback] RGB decoded "
                f"(compressed={self.is_compressed_image}, size={w_rgb}x{h_rgb})"
            )

        self.rgb_queue.put((stamp, rgb))
        # self.logger.loginfo(f"rgb queue {self.rgb_queue.qsize()}")
        if self.rgb_queue.qsize() == 0:
            self.logger.logwarn("rgb queue is empty")
            return
        
        depth = None
        cloud_msg = None
        if self.use_depth_for_seg:
            if len(args) == 2:
                depth_msg, cloud_msg = args
            elif len(args) == 1:
                (depth_msg,) = args
                cloud_msg = None
            else:
                return

            try:
                if self.is_compressed_image:
                    # CompressedImage → depth (passthrough: 16UC1 / 32FC1 그대로 유지)
                    depth = self.bridge.compressed_imgmsg_to_cv2(
                        depth_msg, desired_encoding="passthrough"
                    )
                else:
                    depth = self.bridge.imgmsg_to_cv2(
                        depth_msg, desired_encoding="passthrough"
                    )
            except Exception as e:
                self.logger.logerr(f"[sync_callback] Failed to decode depth image: {e}")
                depth = None
            else:
                # 압축 해제 후 depth 해상도 로그 (한 번만)
                if depth is not None and not hasattr(self, "_logged_depth_shape"):
                    self._logged_depth_shape = True
                    h_d, w_d = depth.shape[:2]
                    self.logger.loginfo(
                        f"[sync_callback] Depth decoded "
                        f"(compressed={self.is_compressed_image}, size={w_d}x{h_d}, dtype={depth.dtype})"
                    )
        else:
            # depth를 사용하지 않는 경우: args는 (cloud_msg,) 이어야 함
            if len(args) != 1:
                return
            (cloud_msg,) = args

        with self.lock:
            # RGB 입력이 한 번이라도 들어왔음을 표시
            self.has_image_input = True
            self.vision_queue.append((stamp, rgb, depth, cloud_msg))

