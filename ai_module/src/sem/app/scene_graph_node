        # Marker 업데이트 주기 (Hz). 0 또는 음수면 비활성화.
        self.marker_update_rate_hz = float(config.get("marker_update_rate_hz", 1.0))
        if self.marker_update_rate_hz > 0.0:
            self.marker_update_period = 1.0 / self.marker_update_rate_hz
        else:
            self.marker_update_period = None
        self.last_marker_update_time = rospy.Time(0)
        # odom 히스토리 유지 시간 (이미지 기준 너무 오래된 odom은 버림)
        self.odom_history_sec = float(config.get("odom_history_sec", 1.0))
