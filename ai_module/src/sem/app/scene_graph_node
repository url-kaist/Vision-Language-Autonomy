                    seconds = int(stamp // 1e9)
                    nanoseconds = int(stamp % 1e9)
                    msg = self.bridge.cv2_to_imgmsg(debug_img, encoding="bgr8")
                    msg.header.stamp = rospy.Time(secs=seconds, nsecs=nanoseconds)
