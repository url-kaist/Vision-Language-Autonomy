    def run(self):
        iter = 0
        while self.running and not rospy.is_shutdown():
            if not self.already_set_classes:
                self.logger.log(f"Wait for classes...")
                rospy.sleep(0.5)
                continue

            # RGB subscribe가 아직 한 번도 돌지 않았다면 YOLO 파이프라인도 돌리지 않음
            with self.lock:
                has_image_input = self.has_image_input
            if not has_image_input:
                if not self._no_image_log_printed:
                    self.logger.logwarn("[YOLO] No RGB messages received yet; YOLO pipeline idle")
                    self._no_image_log_printed = True
                rospy.sleep(0.1)
                continue
            else:
                # 한 번이라도 이미지가 들어오기 시작하면 이후 경고는 끔
                if self._no_image_log_printed:
                    self.logger.loginfo("[YOLO] RGB subscription active; starting YOLO/SAM/3D pipeline")
                    self._no_image_log_printed = False

            # self.logger.loginfo(f"=== Perception iteration {iter} ===")
            t0 = time.time()
            result = self.get_latest_blocking(self.yolo_queue)
            if result is None:
                # YOLO 프로세스에서 결과를 받지 못한 경우
                self.logger.logwarn("No YOLO result received; skipping iteration")
                continue
            wait_time = time.time() - t0

            # YOLO 프로세스에서 infer_time까지 함께 전달되는 경우와
